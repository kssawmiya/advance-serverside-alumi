# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas - replace <cluster> with your Atlas cluster hostname
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alumni_db

# JWT - use a strong random secret (min 32 chars)
JWT_SECRET=your-very-long-random-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=7d

# Email (Nodemailer) - use Ethereal for dev: https://ethereal.email
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your-ethereal-user@ethereal.email
EMAIL_PASS=your-ethereal-password
EMAIL_FROM=noreply@eastminster.ac.uk

# App base URL (for email verification links)
BASE_URL=http://localhost:3000

# University domain restriction for registration
UNIVERSITY_DOMAIN=eastminster.ac.uk

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
